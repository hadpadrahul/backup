{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "source": "ubuntu_old", //or "auto"
    "padding": {
      "top": 2,
      "left": 2,
      "right": 2
    }
  },

  "display": {
    "separator": " : ",
    "key": {
      "width": 12
    },
    "bar": {
      "width": 12
    },
    "percent": {
      "type": 9
    }
  },

  "modules": [
    "title",
    "separator",

    {
      "type": "os",
      "key": "OS"
    },
    {
      "type": "host",
      "key": "Host"
    },
    {
      "type": "kernel",
      "key": "Kernel"
    },
    {
      "type": "uptime",
      "key": "Uptime"
    },
    {
      "type": "display",
      "key": "Display"
    },

    "break",

    {
      "type": "cpu",
      "key": "CPU",
      "temp": true
    },
    {
      "type": "cpuusage",
      "key": "CPU Usage"
    },
    {
      "type": "memory",
      "key": "Memory"
    },
    {
      "type": "swap",
      "key": "Swap"
    },
    {
      "type": "disk",
      "key": "Disk"
    },

    "break",

    {
      "type": "localip",
      "key": "Local IP"
    },
    {
      "type": "wifi",
      "key": "WiFi"
    },
    {
      "type": "netio",
      "key": "Network"
    },

    "break",

    {
      "type": "loadavg",
      "key": "Load Avg"
    },
    {
      "type": "processes",
      "key": "Processes"
    },
    {
      "type": "users",
      "key": "Users"
    },
    {
      "type": "shell",
      "key": "Shell"
    },
    {
      "type": "datetime",
      "key": "Time",
      "format": "{hour-pretty}:{minute-pretty}:{second-pretty}"
    }
  ]
}