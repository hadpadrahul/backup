{
  "$schema": "https://raw.githubusercontent.com/fastfetch-cli/fastfetch/dev/doc/json_schema.json",
  "logo": {
    "source": "ubuntu_old", //or "auto"
    "padding": {
      "top": 1,
      "left": 2,
      "right": 2
    }
  },
  "display": {
    "separator": " : ",
    "key": {
      "width": 12
    },
    "bar": {
      "width": 12
    },
    "percent": {
      "type": 9
    }
  },
  "modules": [
    "title",
    "separator",
    { "type": "os", "key": "OS" },
    { "type": "host", "key": "Host" },
    { "type": "kernel", "key": "Kernel" },
    { "type": "uptime", "key": "Uptime" },
    { "type": "display", "key": "Display" },
    "break",
    { "type": "cpu", "key": "CPU", "temp": true },
    { "type": "memory", "key": "Memory" },
    { "type": "swap", "key": "Swap" },
    { "type": "disk", "key": "Disk" },
    "break",
    { "type": "localip", "key": "Local IP" },
    "break",
    { "type": "loadavg", "key": "Load Avg" },
    { "type": "processes", "key": "Processes" },
    { "type": "users", "key": "Users" },
    { "type": "shell", "key": "Shell", "format": "{pretty-name}" },
    { "type": "datetime", "key": "Time", "format": "{hour-pretty}:{minute-pretty}:{second-pretty}" }
  ]
}
