{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  //////////////////////////
  // COLORS (Catppuccin Mocha)
  //////////////////////////
  // Base palette (dark background, calm pastels)
  "colors": {
    "background": "#1E1E2E",  // Mocha dark
    "foreground": "#CDD6F4",  // Soft text
    "primary": "#89B4FA",     // Blue highlight
    "accent": "#F5C2E7",      // Magenta pastel
    "cursor": "#F5E0DC"       // Light mocha accent
  },

  //////////////////////////
  // LOGO & PADDING
  //////////////////////////
  "logo": {
    "type": "auto", 
    "padding": { "top": 1, "left": 2 },
    // Text color for logo if printed
    "color": { "1": "\u001b[38;5;111m" }
  },

  //////////////////////////
  // GENERAL DISPLAY SETTINGS
  //////////////////////////
  "display": {
    // Show full OS and host
    "os": true,
    "host": true,
    "kernel": true,
    "uptime": true,
    "packages": true,

    // Hardware info
    "cpu": true,
    "gpu": true,
    "memory": true,

    // Network info
    "local_ip": true,
    "public_ip": true,
    "network_speed": true,

    // Storage usage
    "disk": true,

    // Users & shell info
    "users": true,
    "shell": true
  },

  //////////////////////////
  // EXTRA SECTIONS
  //////////////////////////
  "sections": [
    "logo",
    "os",
    "host",
    "kernel",
    "uptime",
    "packages",
    "cpu",
    "gpu",
    "memory",
    "disk",
    "local_ip",
    "public_ip",
    "network_speed",
    "users",
    "shell"
  ],

  //////////////////////////
  // NETWORK & IP SETTINGS
  //////////////////////////
  "local_ip": {
    "interface": "auto"  // auto detect
  },

  "public_ip": {
    "enabled": true,
    "source": "auto"
  }
}
